# Debug-only local configuration. Copy this file to .env and fill in the value.
# .env is ignored by Git and is not used by packaged release builds.
DESKTOP_AI_LLM_API_KEY=
# When present, these values override the saved Provider settings on startup.
DESKTOP_AI_LLM_PROVIDER=openai_compatible
DESKTOP_AI_LLM_ENDPOINT=https://api.deepseek.com
DESKTOP_AI_LLM_MODEL=deepseek-v4-flash

{
  "name": "desktop-ai-companion",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "pnpm --filter @desktop-ai/desktop dev",
    "build": "pnpm --filter @desktop-ai/desktop build",
    "test": "pnpm --filter @desktop-ai/desktop test",
    "test:audio-host:wake": "./scripts/test-audio-host-wake.sh",
    "tauri": "pnpm --filter @desktop-ai/desktop tauri",
